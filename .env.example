# ==================================
# VetCare — Пример конфигурации
# ==================================
# Скопируйте этот файл в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env в репозиторий!

# Flask Settings
FLASK_APP=app.run
FLASK_ENV=development
FLASK_DEBUG=1

# Секретный ключ 
SECRET_KEY=vetcare-dev-secret-key-change-in-production

# База данных
# Локально: sqlite:///vetcare.db
# В Docker: sqlite:///instance/vetcare.db
DATABASE_URL=sqlite:///vetcare.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Сервер
APP_HOST=0.0.0.0
APP_PORT=5000

# Безопасность
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME=3600

# Email (опционально)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_USE_TLS=True
ADMIN_EMAIL=admin@vetcare.local

# Загрузка файлов
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216