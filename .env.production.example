# ==================================
# VetCare PRODUCTION Configuration
# ==================================
# Скопируйте в .env.production и заполните реальными значениями.
# НИКОГДА не коммитьте .env.production в репозиторий!

# Flask Settings
FLASK_APP=app.run
FLASK_ENV=production
FLASK_DEBUG=0

# Server
APP_HOST=0.0.0.0
APP_PORT=5000
ALLOWED_HOSTS=localhost,127.0.0.1

# Security
SECRET_KEY=change_me_to_strong_random_string_32_chars_minimum
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME=1800

# Database
DATABASE_URL=sqlite:////app/instance/vetcare.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Logging
LOG_LEVEL=WARNING
LOG_FILE=/app/logs/vetcare.log

# Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Gunicorn (WSGI server)
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
GUNICORN_BIND=0.0.0.0:5000