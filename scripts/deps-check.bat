@echo off
chcp 65001 > nul
cd /d "%~dp0\.."

echo ========================================
echo  VetCare: Проверка зависимостей
echo ========================================
echo.

echo [1/3] Проверка на уязвимости (pip-audit)...
echo ----------------------------------------
pip-audit
if errorlevel 1 (
    echo [ВНИМАНИЕ] Найдены уязвимые зависимости
) else (
    echo [OK] Уязвимостей не найдено
)
echo.

echo [2/3] Проверка устаревших пакетов...
echo ----------------------------------------
pip list --outdated
echo.

echo [3/3] Версии ключевых зависимостей...
echo ----------------------------------------
pip show flask flask-sqlalchemy flask-login werkzeug | findstr "Name: Version:"
echo.

echo ========================================
echo  Проверка зависимостей завершена
echo ========================================
pause